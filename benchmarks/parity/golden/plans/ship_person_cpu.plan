# A RESOLVED chain, written by `shipinfer plan` -- do not hand-edit.
plan 3 ship_person_cpu
setting workers 7
setting pipeline_queue 257
setting instance_queue 65
setting enqueue_block_timeout_ms 51
setting stage_timeout_ms 5001
setting reassembly_capacity 1025
setting reassembly_timeout_ms 1501
setting reassembly_sweep_ms 101
policy power_of_two
policy_option probes 3
label 0 person
label 8 ship

node decode decode replay

node detect detect pool
model ship_detector
letterbox 640 640
score 0.25
max_detections 300
instances 2
queue_delay_us 5000
artefact ship_detector/1/model.plan

node segment segment pool
model ship_segmenter
classes ship
crop 640 640
instances 2
queue_delay_us 8000
artefact ship_segmenter/1/model.plan
fold_detections output0
fold_prototypes output1
fold_score 0.25
fold_mask 0.5

node embed_person embed pool
model person_embedder
classes person
crop 256 128
instances 2
queue_delay_us 3000
artefact person_embedder/1/model.plan

node embed_ship embed pool
model ship_embedder
classes ship
crop 256 128
instances 1
queue_delay_us 8000
artefact ship_embedder/1/model.plan

node track track shipvision
per camera

node mtmc mtmc shipvision
scope global

node output output jsonlines

edge decode detect bgr@cpu
edge detect segment bgr@cpu
edge detect embed_person bgr@cpu
edge segment embed_ship bgr@cpu
edge embed_person track bgr@cpu
edge embed_ship track bgr@cpu
edge track mtmc meta@cpu
edge mtmc output meta@cpu
field embedding embed_person embed_ship
field mask_area_px segment
