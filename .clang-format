# C++/CUDA formatting for native/.
#
# Two deviations from LLVM's defaults, both deliberate and both the project owner's
# preference — written down here so clang-format enforces them instead of them being
# re-litigated in review:
#
#   NamespaceIndentation: All      namespace contents are indented, so nesting is visible
#                                  at a glance instead of being inferred from a closing brace
#                                  three hundred lines away.
#   IndentAccessModifiers: true    `public:` gets its own indentation level and members sit
#                                  one level deeper, rather than the access specifier being
#                                  outdented past the class body.
#
# ColumnLimit matches the Python side (black's line-length 96), so a file does not change
# shape depending on which language it is written in.
---
Language: Cpp
BasedOnStyle: LLVM

IndentWidth: 2
TabWidth: 2
UseTab: Never
ColumnLimit: 96

NamespaceIndentation: All
IndentAccessModifiers: true
CompactNamespaces: false
FixNamespaceComments: true

# `template <typename T> class Foo {` stays on one line when it fits.
AlwaysBreakTemplateDeclarations: No

# `char* p`, not `char *p`: the pointer is part of the type.
PointerAlignment: Left
ReferenceAlignment: Left
DerivePointerAlignment: false

AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
BreakBeforeBraces: Attach
SeparateDefinitionBlocks: Leave

SortIncludes: CaseSensitive
IncludeBlocks: Preserve
...
