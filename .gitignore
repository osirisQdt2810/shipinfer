# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# --- Native build ---------------------------------------------------------
native/build/
*.so
*.o
compile_commands.json
.cache/

# --- Model artefacts ------------------------------------------------------
# Engines are host-specific (GPU arch + TensorRT version) and weights are large:
# both live in the model repository on disk / object storage, never in git.
*.engine
*.plan
*.onnx
*.pth
*.pt
*.trt

# --- Local config & secrets ----------------------------------------------
.env
.env.*
config/*.local.yaml
config/secrets.yaml

# --- Run artefacts --------------------------------------------------------
.artifacts/
logs/
*.log
profile_*.nsys-rep
*.qdrep
*.sqlite

# --- Vendored reference checkouts ----------------------------------------
# `references/` holds read-only clones of the upstream ShipControlPrj services. They are
# fetched by scripts/sync_references.sh, not tracked here (each has its own git history).
references/

# --- Editors --------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.DS_Store
.claude/settings.local.json

# Third-party evaluation datasets, fetched by scripts/fetch_datasets.py.
# Never committed: they carry their own licences (MOT17 is CC BY-NC-SA) and are large.
/data/

# Model weights, ONNX exports and TensorRT engines — see models/README.md.
# Large, licensed separately, and an engine is valid only for the GPU that built it.
/models/*
!/models/README.md

# Built TensorRT plans in the model repository. Same reason as models/: an engine is valid
# only for the GPU and TensorRT version that built it.
model_repository/*/*/*.plan

# The host-built C++ data plane. Built by scripts/build_csrc.py, never committed: it is a
# host artefact against this box's TensorRT and CUDA, and a checked-in binary is a binary
# nobody can tell is stale.
csrc/build/
# the Stop hook's consecutive-block counter, written beside the ledger
.claude/.tasks_state.json
